{
  "name": "sonora",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run build:wasm && vite --port 5173 --open /web.html",
    "build": "npm run build:wasm && tsc && vite build",
    "build:wasm": "wasm-pack build crates/sonora-dsp-wasm --release --target web --out-dir ../../src/audio/wasm-pkg --out-name sonora_dsp",
    "gen:audio": "node scripts/gen-test-audio.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "events": "esbuild scripts/event-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/event-report.mjs --log-level=warning && node node_modules/.cache/event-report.mjs",
    "media": "node scripts/media.mjs",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "ui:shots": "node scripts/ui-shots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
