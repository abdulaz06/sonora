{
  "name": "sonora",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run build:wasm && vite --port 5173 --open /web.html",
    "build": "npm run build:wasm && tsc && vite build",
    "build:wasm": "wasm-pack build crates/sonora-dsp-wasm --release --target web --out-dir ../../src/audio/wasm-pkg --out-name sonora_dsp",
    "gen:audio": "node scripts/gen-test-audio.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "events": "esbuild scripts/event-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/event-report.mjs --log-level=warning && node node_modules/.cache/event-report.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "playwright": "^1.65.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
