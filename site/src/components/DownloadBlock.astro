---
import { release, metaLabel } from '../lib/release';
---
<section class="solid dl" id="download" aria-labelledby="dl-h">
  <div class="wrap">
    <p class="kicker label"><span class="n">07</span><span class="line"></span>download</p>
    <h2 class="display dl-big" id="dl-h">see your music.</h2>
    <div class="dl-grid">
      <div>
        <span class="micro">sonora for windows</span>
        <p style="margin-top:18px"><a class="btn btn--primary" href={release.url} data-dl>
          <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3.5 5.5 7 9l3.5-3.5M1.5 12.5h11" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          Download for Windows</a></p>
        <p class="micro" style="margin-top:14px" data-dl-meta>{metaLabel(release)}</p>
        <p class="small" style="margin-top:22px">Free. Updates itself from GitHub with one click. <span class="bone">Coming to Steam.</span></p>
        <p class="small" style="margin-top:10px">No Windows PC? <a class="link-arrow" href="/live">Try it in your browser</a></p>
      </div>
      <div>
        <span class="micro">system requirements</span>
        <ul>
          <li><span>system</span><span>Windows 10 or 11, 64-bit</span></li>
          <li><span>graphics</span><span>A GPU with WebGL 2 and float render targets: most cards from the last ten years, integrated ones included</span></li>
          <li><span>runtime</span><span>Microsoft Edge WebView2 (built into Windows 11; the installer adds it on Windows 10 if needed)</span></li>
          <li><span>audio</span><span>Whatever your PC plays: Spotify, browsers, games. No setup</span></li>
        </ul>
      </div>
      <div>
        <span class="micro">first launch</span>
        <p class="small" style="margin-top:14px">The installer isn’t code-signed yet, so Windows SmartScreen asks first: choose <span class="bone">More info</span>, then <span class="bone">Run anyway</span>.</p>
        <div class="ss">
          <figure>
            <svg viewBox="0 0 200 120" role="img" aria-label="Step 1: the SmartScreen notice, with the More info link">
              <rect width="200" height="120" fill="#08080A"/>
              <rect x="14" y="16" width="120" height="7" fill="#ECE7DF" fill-opacity=".8"/>
              <rect x="14" y="34" width="168" height="4" fill="#ECE7DF" fill-opacity=".3"/>
              <rect x="14" y="43" width="150" height="4" fill="#ECE7DF" fill-opacity=".3"/>
              <text x="14" y="66" fill="#ECE7DF" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="1">MORE INFO</text>
              <rect x="14" y="69" width="52" height="1" fill="#ECE7DF"/>
              <rect x="128" y="92" width="58" height="16" fill="none" stroke="#ECE7DF" stroke-opacity=".35"/>
              <text x="157" y="103" fill="#ECE7DF" fill-opacity=".55" font-family="IBM Plex Mono, monospace" font-size="7" text-anchor="middle" letter-spacing="1">DON'T RUN</text>
            </svg>
            <figcaption class="micro">1 · more info</figcaption>
          </figure>
          <figure>
            <svg viewBox="0 0 200 120" role="img" aria-label="Step 2: the same notice with the Run anyway button">
              <rect width="200" height="120" fill="#08080A"/>
              <rect x="14" y="16" width="120" height="7" fill="#ECE7DF" fill-opacity=".8"/>
              <rect x="14" y="34" width="168" height="4" fill="#ECE7DF" fill-opacity=".3"/>
              <text x="14" y="58" fill="#ECE7DF" fill-opacity=".55" font-family="IBM Plex Mono, monospace" font-size="7" letter-spacing="1">APP: SONORA_SETUP.EXE</text>
              <rect x="62" y="92" width="58" height="16" fill="#ECE7DF"/>
              <text x="91" y="103" fill="#08080A" font-family="IBM Plex Mono, monospace" font-size="7" text-anchor="middle" letter-spacing="1">RUN ANYWAY</text>
              <rect x="128" y="92" width="58" height="16" fill="none" stroke="#ECE7DF" stroke-opacity=".35"/>
              <text x="157" y="103" fill="#ECE7DF" fill-opacity=".55" font-family="IBM Plex Mono, monospace" font-size="7" text-anchor="middle" letter-spacing="1">DON'T RUN</text>
            </svg>
            <figcaption class="micro">2 · run anyway</figcaption>
          </figure>
        </div>
      </div>
    </div>
    <p class="story-line">built by abdul, who plays everything at full volume. <a href="/engineering#story">read the story →</a></p>
  </div>
</section>
