---
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import Footer from '../components/Footer.astro';
import DownloadBlock from '../components/DownloadBlock.astro';
import Fallback from '../components/Fallback.astro';
import { ART_STYLES, STYLE_INFO, mediaFor } from '../../../src/app/catalog';
import { PALETTES, paletteFromHue } from '../../../src/engine/color-engine';
import { release, metaLabel } from '../lib/release';
import { SCENES, PALETTE_SCENE, HUES } from '../lib/scenes';
import demo from '../generated/demo.json';

const hero = { href: '/media/hero-1920.webp', srcset: '/media/hero-960.webp 960w, /media/hero-1600.webp 1600w, /media/hero-1920.webp 1920w', sizes: '100vw' };
const sections = (demo.sections as [string, number, number][]).filter(([n]) => n !== 'silence');
const dur = demo.seconds;
const palettes = PALETTES.map((p, i) => ({ i, name: p.name, core: p.preview, accent: p.previewAccent }));
const hues = HUES.map((h) => ({ h, core: paletteFromHue(h).preview }));
const title = 'sonora — see your music';
const description = 'A visual instrument for whatever’s playing: a free Windows music visualizer that listens to your PC and paints it live, in time with every beat. Try it in your browser.';
---
<Base title={title} description={description} path="/" og="/og/home.jpg" ogAlt="Ink Marble in the Ember palette, with the sonora lockup and the line see your music." page="home" preloadImage={hero}>
  <script is:inline>
    // Before first paint: choose live engine or loops/stills, so nothing jumps.
    (function () {
      var d = document.documentElement, m = function (q) { return window.matchMedia(q).matches; };
      var reduced = m('(prefers-reduced-motion: reduce)');
      var phone = m('(pointer: coarse)') && Math.min(screen.width, screen.height) < 820;
      var weak = (navigator.deviceMemory && navigator.deviceMemory < 4) || (navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4);
      var save = navigator.connection && navigator.connection.saveData;
      var gl2 = 'WebGL2RenderingContext' in window;
      var force = /[?&]static/.test(location.search), forceLive = /[?&]live/.test(location.search);
      var stat = force || (!forceLive && (reduced || phone || weak || save || !gl2));
      if (stat) d.classList.add('static');
      if (reduced) d.classList.add('reduced');
      d.classList.add('nav-clear');
    })();
  </script>

  <canvas class="stage" id="stage" aria-hidden="true"></canvas>
  <div class="stage-hold" id="stage-hold" aria-hidden="true"></div>

  <main id="main">
    <!-- 1 · Hero -->
    <section class="live hero" data-scene="hero" aria-label="sonora">
      <div class="poster" id="poster"><img src={hero.href} srcset={hero.srcset} sizes={hero.sizes} alt="" fetchpriority="high" decoding="async" width="1920" height="1080" /></div>
      <Fallback media="ink-glow" videoOnly />
      <div class="wrap">
        <div class="hero-inner">
          <div>
            <Lockup class="hero-lockup" title="sonora" />
            <h1 class="display">see your music.</h1>
            <div class="hero-cta">
              <a class="btn btn--primary" href={release.url} data-dl>
                <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3.5 5.5 7 9l3.5-3.5M1.5 12.5h11" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                Download for Windows
              </a>
              <a class="btn" href="/live">Try it live
                <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9.5M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </a>
            </div>
            <p class="micro hero-meta" data-dl-meta>{metaLabel(release)} · free</p>
          </div>
          <div class="hero-side">
            <p class="micro live-tag needs-engine"><span class="live-dot" aria-hidden="true"></span><span id="hero-tag">live engine · ink · glow · depth</span></p>
            <p class="micro live-tag only-static"><span>ink · glow · depth</span></p>
            <div class="hero-side-btns" style="display:flex;gap:8px">
              <button class="toggle" type="button" data-sound aria-pressed="false"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span><span data-sound-label>Sound off</span></button>
              <button class="toggle" type="button" data-trailer>Watch the trailer</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · It hears the song -->
    <section class="live hears" data-scene="hears" aria-labelledby="hears-h">
      <Fallback media="ink-glow" />
      <div class="wrap">
        <div class="hears-grid">
          <div class="rv">
            <p class="kicker label"><span class="n">01</span><span class="line"></span>listening</p>
            <h2 class="h1" id="hears-h">it hears the song, not just the volume.</h2>
            <p class="lede">Kicks, snares, hats, builds, drops and track changes are picked out as they happen, so the picture moves with the music instead of a meter. This is the real analysis of the demo track, live.</p>
          </div>
          <div class="board panel rv" aria-label="What sonora hears, live">
            <div class="board-head"><span class="label bone">signals</span><span class="micro" id="bd-clock">0:00 / {Math.floor(dur / 60)}:{String(Math.floor(dur % 60)).padStart(2, '0')}</span></div>
            <div class="board-grid">
              {[['kick', 'Kick'], ['snare', 'Snare'], ['hats', 'Hats'], ['bass', 'Bass'], ['build', 'Build'], ['drop', 'Drop'], ['breakdown', 'Breakdown'], ['bigHit', 'Big hit'], ['trackChange', 'Track change']].map(([id, name], i) => (
                <div class:list={['sig', i >= 4 && 'ev']} data-sig={id}><span class="name">{name}</span><span class="bar"><i></i></span></div>
              ))}
            </div>
            <div class="board-foot">
              <div><span class="micro">tempo</span><div class="v" id="bd-bpm">— bpm</div></div>
              <div><span class="micro">section</span><div class="v" id="bd-section">intro</div></div>
              <div><span class="micro">intensity</span><div class="v" id="bd-int">0.00</div></div>
            </div>
            <div class="timeline" aria-hidden="true">
              {sections.map(([n, a, b]) => <div class="sec" style={`left:${(a / dur) * 100}%;width:${((b - a) / dur) * 100}%`}><span>{n === 'breakdown' ? 'break' : n}</span></div>)}
              <div class="head" id="bd-head"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · The styles -->
    <section class="solid styles-intro" id="styles" aria-labelledby="styles-h">
      <div class="wrap">
        <p class="kicker label"><span class="n">02</span><span class="line"></span>five styles</p>
        <h2 class="h1" id="styles-h" style="max-width:12em">five ways to see it. each with its own looks.</h2>
      </div>
    </section>
    {ART_STYLES.map((id, k) => {
      const info = STYLE_INFO[id];
      const sc = SCENES[id];
      return (
        <section class="live style" data-scene={`style-${id}`} data-style={id} aria-labelledby={`st-${id}`}>
          <Fallback media={sc.options[sc.initial].media} id={`fb-${id}`} />
          <div class="wrap">
            <div class="style-card">
              <div class="style-text glass rv">
                <p class="label"><span class="bone">0{k + 1}</span> / 05{info.heavy && <span class="heavy">· heavy on the graphics card</span>}</p>
                <h3 class="display style-name" id={`st-${id}`}>{info.label}</h3>
                <p class="line">{info.line}</p>
                <p class="micro suits">suits {info.suits}</p>
              </div>
              <div class="style-controls rv">
                {sc.options.length < 2 ? <p class="style-more">{info.more}</p> : <div class="grp">
                  <span class="micro">{sc.groupLabel}</span>
                  <div class="chips" role="group" aria-label={`${info.label} ${sc.groupLabel}`}>
                    {sc.options.map((o, j) => (
                      <button type="button" class="chip" data-chip={j} aria-pressed={j === sc.initial ? 'true' : 'false'} data-media={o.media} title={o.title}>{o.label}</button>
                    ))}
                  </div>
                </div>}
              </div>
            </div>
          </div>
        </section>
      );
    })}

    <!-- 4 · Palettes -->
    <section class="live palettes" id="palettes" data-scene="palettes" aria-labelledby="pal-h">
      <Fallback media={`pal-${PALETTE_SCENE.media}-0`} still id="fb-pal" />
      <div class="wrap">
        <div class="pal-card">
          <div class="glass rv" style="max-width:640px">
            <p class="kicker label"><span class="n">03</span><span class="line"></span>new in 1.0.1</p>
            <h2 class="h1" id="pal-h">nine palettes. or any hue.</h2>
            <p class="lede" style="margin-top:20px">Each one tuned in OKLCH so every style stays vivid in every colour: no grey stone, no muddy yellows. Press 1–9 in the app, pick your own hue, or let Auto Drift turn the colours slowly with the music.</p>
          </div>
          <div class="rv">
            <div class="pal-grid" role="group" aria-label="Palettes">
              {palettes.map((p) => (
                <button type="button" class="pal" data-pal={p.i} aria-pressed={p.i === 0 ? 'true' : 'false'} aria-label={`Palette ${p.i + 1}: ${p.name}`}>
                  <span class="sw" aria-hidden="true"><i style={`background:${p.core}`}></i><i style={`background:${p.accent}`}></i></span>
                  <span class="k"><span>{p.i + 1}</span><span>{p.name}</span></span>
                </button>
              ))}
            </div>
            <div class="hues">
              <span class="lab micro">or pick any hue</span>
              <div class="hue-row" role="group" aria-label="Custom hue">
                {hues.map((x) => <button type="button" class="hue needs-engine" data-hue={x.h} aria-pressed="false" aria-label={`Hue ${x.h}°`} style={`background:${x.core}`}></button>)}
                {hues.map((x) => <span class="hue only-static" aria-hidden="true" style={`background:${x.core}`}></span>)}
              </div>
              <button type="button" class="drift needs-engine" data-drift aria-pressed="false">Auto drift</button>
            </div>
            <p class="pal-now micro"><span class="bone" id="pal-name">1 · Ocean</span><span id="pal-auto">cycling · tap one to hold it</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Set Mode -->
    <section class="live setmode" data-scene="setmode" aria-labelledby="sm-h">
      <Fallback media="voyage-city" />
      <div class="wrap">
        <div class="sm-card">
          <div class="glass rv" style="max-width:720px">
            <p class="kicker label"><span class="n">04</span><span class="line"></span>set mode</p>
            <h2 class="h1" id="sm-h">put it on the TV and let it choose.</h2>
            <p class="lede" style="margin-top:20px">Like a VJ, sonora switches style, look and view when the track changes, or on a big drop after a long build, picking calm visuals for calm music and driving ones for four-on-the-floor. Never more often than you allow.</p>
            <div class="sm-actions">
              <button class="btn needs-engine" type="button" data-skip-drop>Skip to the drop</button>
              <button class="btn" type="button" data-trailer>Watch the trailer</button>
            </div>
          </div>
          <div class="sm-log rv needs-engine" aria-live="polite">
            <div class="now"><span class="micro">set mode · now showing</span><div class="v" id="sm-now">ink · glow · depth</div></div>
            <div id="sm-rows"><div class="row"><span>—</span><span>waiting for a drop or a track change</span></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · The app -->
    <section class="solid app" aria-labelledby="app-h">
      <div class="wrap">
        <div class="app-head">
          <div>
            <p class="kicker label"><span class="n">05</span><span class="line"></span>the app</p>
            <h2 class="h1" id="app-h">quiet around the loud part.</h2>
          </div>
          <p class="lede">A home menu of moving thumbnails, settings that explain themselves, and the song that’s playing, from Spotify, a browser or any player that reports to Windows. Real screens from 1.0.1.</p>
        </div>
        <div class="shots">
          <figure class="shot shot--a rv">
            <div class="frame"><img src="/shots/menu-1600.webp" srcset="/shots/menu-960.webp 960w, /shots/menu-1600.webp 1600w, /shots/menu-2400.webp 2400w" sizes="(max-width: 1680px) 100vw, 1600px" width="1600" height="900" alt="The home menu: five styles with moving thumbnails, Continue, Set Mode and the audio source" loading="lazy" decoding="async" /></div>
            <figcaption><span class="label bone">home menu</span><span class="micro">hover a style to watch it move · enter to open</span></figcaption>
          </figure>
          <figure class="shot shot--b rv">
            <div class="frame"><img src="/shots/detail-960.webp" width="960" height="540" alt="Style detail for Ink: looks and views side by side" loading="lazy" decoding="async" /></div>
            <figcaption><span class="label bone">style detail</span><span class="micro">looks and views side by side</span></figcaption>
          </figure>
          <figure class="shot shot--c rv">
            <div class="frame"><img src="/shots/info-960.webp" width="960" height="540" alt="Settings with an (i) card explaining a control with pictures" loading="lazy" decoding="async" /></div>
            <figcaption><span class="label bone">settings · (i) cards</span><span class="micro">every control explained</span></figcaption>
          </figure>
          <figure class="shot shot--d rv">
            <div class="frame"><img src="/shots/playing-960.webp" width="960" height="540" alt="The visual with the now playing title and the control bar" loading="lazy" decoding="async" /></div>
            <figcaption><span class="label bone">now playing</span><span class="micro">song, artist, previous / play / next</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 7 · How it works -->
    <section class="solid how" aria-labelledby="how-h">
      <div class="wrap">
        <div class="how-head">
          <div>
            <p class="kicker label"><span class="n">06</span><span class="line"></span>how it works</p>
            <h2 class="h1" id="how-h">from your speakers to the screen in one frame.</h2>
          </div>
          <p class="lede">One Rust analysis crate runs natively in the app and as WebAssembly in this page. It turns sound into a handful of musical signals and events, and the styles draw only from those.</p>
        </div>
        <div class="pipe rv">
          {[
            ['01', 'system audio', 'WASAPI loopback hears whatever your PC plays. Nothing to route, no virtual cable.'],
            ['02', 'rust dsp', 'FFT, seven bands, per-band normalisation, onsets, tempo and beat phase. 60 frames per second of audio.'],
            ['03', 'mapping layer', 'Presence, hits, intensity and fade, on three timescales, so quiet songs move too.'],
            ['04', 'events', 'Drop, build, breakdown, big hit and track change, with hysteresis so nothing flickers.'],
            ['05', 'webgl 2', 'Fluids, millions of particles and raymarched fractals, HDR bloom, a flash limiter.'],
          ].map(([n, h, p]) => (
            <div class="node">
              <div><span class="micro">{n}</span><h3 class="h3">{h}</h3></div>
              <p>{p}</p>
              <span class="arrow" aria-hidden="true"><svg viewBox="0 0 13 13"><path d="M1 6.5h10M7.5 3l3.5 3.5L7.5 10" fill="none" stroke="#ECE7DF" stroke-opacity=".6" stroke-width="1"/></svg></span>
            </div>
          ))}
        </div>
        <div class="how-foot rv">
          <div><span class="micro">privacy</span><h3 class="h3">no audio leaves your machine.</h3><p class="small" style="margin-top:8px">Analysis runs on your computer. The only request the app makes is the update check.</p></div>
          <div><span class="micro">stack</span><div class="stack mono bone"><span>rust</span><span>wasm</span><span>typescript</span><span>webgl 2</span><span>tauri 2</span><span>wasapi</span></div><p class="small" style="margin-top:10px">Verified by a harness that renders every style on the GPU and checks beat sync, flicker and motion.</p></div>
          <div><span class="micro">deep dive</span><h3 class="h3">the engineering story.</h3><p style="margin-top:14px"><a class="link-arrow mono" href="/engineering">read it <span aria-hidden="true">→</span></a></p></div>
        </div>
      </div>
    </section>

    <!-- 8 · Download -->
    <DownloadBlock />
  </main>
  <Footer />

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="sonora trailer">
    <button class="btn lb-close" type="button" data-lb-close>Close</button>
    <video id="lb-video" controls playsinline preload="none" poster="/media/trailer-poster.webp">
      <source src="/media/sonora-trailer.webm" type="video/webm" />
      <source src="/media/sonora-trailer.mp4" type="video/mp4" />
    </video>
  </div>

  <script>
    import { boot } from '../scripts/landing';
    boot();
  </script>
</Base>
